# Apache SPA routing for cPanel / subdomain deployment
# Serves pre-rendered per-route HTML when available, falls back to SPA

# Disable Apache DirectorySlash (prevents auto-adding trailing slashes)
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Strip ALL query parameters from homepage — 301 to clean "/" ──
  # Prevents ?SA=, ?utm_source=, ?ref=, etc. from being treated as duplicate pages.
  RewriteCond %{QUERY_STRING} .+
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ / [R=301,L,QSD]

  # ── Hard 404s for legacy / malformed URLs (must come BEFORE any redirects) ──
  # Any .shtml file (legacy blueblocks.in extensions — never existed on this domain)
  RewriteRule \.shtml$ - [R=404,L]

  # Legacy CubeSat-INSPACE garbage paths crawled from external broken links → 404
  # (Previously 301-redirected; GSC flagged as redirects instead of indexing real pages.)
  RewriteRule ^publications/CubeSat-INSPACE(/.*)?$ - [R=404,L]

  # ── Strip trailing slashes (except root "/") — 301 redirect /path/ → /path ──
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # ── Skip actual files (JS, CSS, images, etc.) ──
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── Serve pre-rendered per-route index.html if it exists ──
  # This enables static HTML with correct canonical/meta/content per route
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # ── SPA fallback: serve root index.html for routes without pre-rendered HTML ──
  RewriteRule . /index.html [L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Custom 404 page — serves the SPA shell with a real 404 status code
# (The SPA's NotFoundPage component renders for unknown routes.)
ErrorDocument 404 /404.html
