# Apache SPA routing for cPanel / subdomain deployment
# Serves pre-rendered per-route HTML when available, falls back to SPA

# Disable Apache DirectorySlash (prevents auto-adding trailing slashes)
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Strip ALL query parameters from homepage — 301 to clean "/" ──
  # Prevents ?SA=, ?utm_source=, ?ref=, etc. from being treated as duplicate pages.
  RewriteCond %{QUERY_STRING} .+
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ / [R=301,L,QSD]

  # ── Legacy URL handling (per owner directive) ──
  # Specific legacy CubeSat-INSPACE .shtml path → privacy (single 1-hop 301)
  RewriteRule ^publications/CubeSat-INSPACE/privacy-policy\.shtml$ /privacy [R=301,L]

  # Bare /publications/CubeSat-INSPACE (with or without trailing slash) →
  # single 1-hop 301 to the SBB-1 CubeSat authorization publication (closest topical match).
  RewriteRule ^publications/CubeSat-INSPACE/?$ /publications/in-space-authorization-letter [R=301,L]

  # ── Hard 410 Gone for malformed/never-existed CubeSat-INSPACE child URLs ──
  # These .shtml and pseudo-child paths leak in from the legacy blueblocks.in school site
  # and have no replacement on this research subdomain. 410 tells Google to de-index permanently.
  # Covers: /publications/CubeSat-INSPACE/campus.shtml, our-programs.shtml, montessori.shtml,
  # nursery-school.shtml, innovation.shtml, positive-parenting.shtml, etc.
  RewriteRule ^publications/CubeSat-INSPACE/.+ - [R=410,L]
  # Malformed concatenated slug (e.g. /publications/CubeSat-INSPACEIndependent)
  RewriteRule ^publications/CubeSat-INSPACE[^/]+$ - [R=410,L]

  # Legacy /blueblocks/* and /blueblocks/blog/ → 410 Gone (no replacement on this subdomain)
  RewriteRule ^blueblocks(/.*)?$ - [R=410,L]

  # Catch-all: any remaining .shtml URL → 410 Gone (legacy school site, never existed here)
  RewriteRule \.shtml$ - [R=410,L]

  # ── Strip trailing slashes (except root "/") — 301 redirect /path/ → /path ──
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # ── 301 redirect: /governance/team → /team (no dedicated governance team page) ──
  RewriteRule ^governance/team$ /team [R=301,L]

  # ── Hard 410 Gone for routes intentionally removed / never built ──
  # (Previously returned 404 — 410 is a stronger, faster de-indexing signal for Google.)
  RewriteRule ^proceedings$ - [R=410,L]
  RewriteRule ^technical-briefs$ - [R=410,L]
  RewriteRule ^downloads/leadership-bio-sheet$ - [R=410,L]

  # ── Hard 410 Gone for unrecognised /publications/<slug> URLs (whitelist valid slugs) ──
  RewriteCond %{REQUEST_URI} ^/publications/([^/]+)$
  RewriteCond %1 !^(achievement-without-sight|ami-congress-2026|biophilia-drawing-dataset|biophilia-drawing-preregistration|citation-standards|crocodilian-skull-kutch-taphonomy|cross-study-dataset|data|deep-time-palaeontology|flipside-case-study|glossary|in-space-authorization-letter|iran-war-case-study|meerkat-bio-leadership|meerkat-bio-leadership-dataset|resilience-workshop|saparya-imf-case-study|structured-debate-side-switch|tedx-hyderabad-orienting-question)$
  RewriteRule ^ - [R=410,L]

  # ── Skip actual files (JS, CSS, images, etc.) ──
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── Serve pre-rendered per-route index.html if it exists ──
  # This enables static HTML with correct canonical/meta/content per route
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # ── Unknown route: return a true HTTP 404 (never a soft 200 SPA shell) ──
  # Every valid route is pre-rendered to /<route>/index.html by the build, so
  # anything reaching this point does not exist. ErrorDocument serves /404.html.
  RewriteRule . - [R=404,L]

</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Custom 404 page — serves the SPA shell with a real 404 status code
# (The SPA's NotFoundPage component renders for unknown routes.)
ErrorDocument 404 /404.html
