# Apache SPA routing for cPanel / subdomain deployment
# Serves pre-rendered per-route HTML when available, falls back to SPA

# Disable Apache DirectorySlash (prevents auto-adding trailing slashes)
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Strip ALL query parameters from homepage — 301 to clean "/" ──
  # Prevents ?SA=, ?utm_source=, ?ref=, etc. from being treated as duplicate pages.
  RewriteCond %{QUERY_STRING} .+
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ / [R=301,L,QSD]

  # ── Legacy URL 301 redirects (per owner directive) ──
  # Specific legacy CubeSat-INSPACE .shtml paths → mapped live pages
  RewriteRule ^publications/CubeSat-INSPACE/privacy-policy\.shtml$ /privacy [R=301,L]
  RewriteRule ^publications/CubeSat-INSPACE/nursery-school\.shtml$ /publications [R=301,L]
  RewriteRule ^publications/CubeSat-INSPACE/our-programs\.shtml$ /publications [R=301,L]
  RewriteRule ^publications/CubeSat-INSPACE/innovation\.shtml$ /publications [R=301,L]
  RewriteRule ^publications/CubeSat-INSPACE/montessori\.shtml$ /publications [R=301,L]
  RewriteRule ^publications/CubeSat-INSPACE/positive-parenting\.shtml$ /publications [R=301,L]

  # Legacy /blueblocks/blog/ (and anything under /blueblocks/) → /publications
  RewriteRule ^blueblocks(/.*)?$ /publications [R=301,L]

  # Catch-all: any remaining .shtml URL → homepage (future-proof)
  RewriteRule \.shtml$ / [R=301,L]

  # ── Strip trailing slashes (except root "/") — 301 redirect /path/ → /path ──
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # ── 301 redirect: /governance/team → /team (no dedicated governance team page) ──
  RewriteRule ^governance/team$ /team [R=301,L]

  # ── Hard 404s for routes with no content (prevents Google soft-404 flags) ──
  RewriteRule ^proceedings$ - [R=404,L]
  RewriteRule ^technical-briefs$ - [R=404,L]
  RewriteRule ^downloads/leadership-bio-sheet$ - [R=404,L]

  # ── Hard 404 for malformed/legacy CubeSat-INSPACE publication slugs ──
  RewriteRule ^publications/CubeSat-INSPACE - [R=404,L]

  # ── Hard 404 for unrecognised /publications/<slug> URLs (whitelist valid slugs) ──
  RewriteCond %{REQUEST_URI} ^/publications/([^/]+)$
  RewriteCond %1 !^(citation-standards|data|flipside-case-study|glossary|in-space-authorization-letter|iran-war-case-study|resilience-workshop|saparya-imf-case-study|structured-debate-side-switch)$
  RewriteRule ^ - [R=404,L]

  # ── Skip actual files (JS, CSS, images, etc.) ──
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # ── Serve pre-rendered per-route index.html if it exists ──
  # This enables static HTML with correct canonical/meta/content per route
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # ── SPA fallback: serve root index.html for routes without pre-rendered HTML ──
  RewriteRule . /index.html [L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Custom 404 page — serves the SPA shell with a real 404 status code
# (The SPA's NotFoundPage component renders for unknown routes.)
ErrorDocument 404 /404.html
